# Gluetun secrets — copy to .env and fill in your values
# This file is not committed (see .gitignore)

# Surfshark WireGuard credentials
# Admin panel → Manual setup → WireGuard
SURFSHARK_WIREGUARD_PRIVATE_KEY=changeme
SURFSHARK_WIREGUARD_ADDRESSES=changeme/16

# Surfshark OpenVPN credentials
# Admin panel → Manual setup → OpenVPN config → service credentials
# SURFSHARK_OPENVPN_USER=changeme
# SURFSHARK_OPENVPN_PASSWORD=changeme

# ProtonVPN WireGuard credentials
# Generate at account.proton.me/vpn/WireGuard
# WIREGUARD_ADDRESSES is always 10.2.0.2/32 for all ProtonVPN servers
PROTONVPN_WIREGUARD_PRIVATE_KEY=changeme
PROTONVPN_WIREGUARD_ADDRESSES=10.2.0.2/32

# ProtonVPN OpenVPN credentials
# account.proton.me/vpn/OpenVPN → OpenVPN username / password
# PROTONVPN_OPENVPN_USER=changeme
# PROTONVPN_OPENVPN_PASSWORD=changeme

# Gluetun control server
HTTP_CONTROL_SERVER_API_KEY=changeme
