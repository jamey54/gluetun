# Gluetun secrets — copy to .env and fill in your values
# This file is not committed (see .gitignore)

# Surfshark WireGuard credentials
# Admin panel → Manual setup → WireGuard
SURFSHARK_WIREGUARD_PRIVATE_KEY=changeme
SURFSHARK_WIREGUARD_ADDRESSES=changeme/16

# ProtonVPN WireGuard credentials
# Generate at account.proton.me/vpn/WireGuard
PROTONVPN_WIREGUARD_PRIVATE_KEY=changeme
PROTONVPN_WIREGUARD_ADDRESSES=changeme/32

# Gluetun control server
HTTP_CONTROL_SERVER_API_KEY=changeme
