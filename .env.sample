# Epoxy secrets — copy to .env and fill in your values
# This file is not committed (see .gitignore)
# Values are intentionally blank: the CLI refuses to run with unset
# credentials, so an unedited copy fails closed instead of half-working.

# Surfshark WireGuard credentials
# Admin panel → Manual setup → WireGuard
SURFSHARK_WIREGUARD_PRIVATE_KEY=
SURFSHARK_WIREGUARD_ADDRESSES=

# Surfshark OpenVPN credentials
# Admin panel → Manual setup → OpenVPN config → service credentials
# SURFSHARK_OPENVPN_USER=
# SURFSHARK_OPENVPN_PASSWORD=

# ProtonVPN WireGuard credentials
# Generate at account.proton.me/vpn/WireGuard
# WIREGUARD_ADDRESSES is always 10.2.0.2/32 for all ProtonVPN servers
PROTONVPN_WIREGUARD_PRIVATE_KEY=
PROTONVPN_WIREGUARD_ADDRESSES=10.2.0.2/32

# ProtonVPN OpenVPN credentials
# account.proton.me/vpn/OpenVPN → OpenVPN username / password
# PROTONVPN_OPENVPN_USER=
# PROTONVPN_OPENVPN_PASSWORD=

# Container control server (any random string; required for up/connect/bench)
HTTP_CONTROL_SERVER_API_KEY=

# Optional: bake a starting location into the container at creation time.
# Comma-separated, using Gluetun's country/city names (see `epoxy connect --list`).
# These only apply when the container is created or recreated; after that, all
# runtime selection changes go through the control server (`epoxy connect`).
# SERVER_COUNTRIES=Germany
# SERVER_CITIES=Berlin
